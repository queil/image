FROM docker.io/fedora:45

ARG USER=queil
ARG HOME=/home/$USER

RUN microdnf update -y && \
    microdnf install -y --nodocs --setopt install_weak_deps=0 \
    man mmv systemd tar unzip bash-completion git git-delta jq dnsutils tree gh \
    iproute htop which procps-ng tree fzf openssh-clients \
    ln -s /usr/bin/python3 /usr/bin/python && \
    adduser $USER && chown $USER -R $HOME

WORKDIR $HOME
USER $USER

ENV PATH="$HOME/.local/bin:${PATH}"

RUN mkdir -p ~/.config/micro/plug/lsp && \
    git clone -b fsharp https://github.com/queil/micro-plugin-lsp.git ~/.config/micro/plug/lsp

WORKDIR $HOME

ENV XDG_RUNTIME_DIR="/tmp"


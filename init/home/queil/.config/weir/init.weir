#init

// the project badge (Cargo, .NET, Node, Python, Go, Maven, Helm, Dart,
// Elixir, PHP, Ruby) lives beside this file
import "./project.weir"

#alias st = git-status.weir
#alias ga = git add
#alias di = git diff
#alias co = git checkout
#alias cb = git checkout -b
#alias pl = git pull
#alias pu = git push -u origin

let inf () = git add . | and git commit -a --amend --no-edit

let branch () = git rev-parse --symbolic-full-name --abbrev-ref HEAD | line

let cm msg = git commit -m $msg

let gl = git log --oneline -n 10

let wipe () = git reset --hard | and git clean -xfd

// kubeconfig: only what the prompt shows; other keys are ignored
type KubeCtx = { name: string; context: {| namespace: Option<string> |} }

type KubeConfig = {
    [<Wire "current-context">]
    current: Option<string>
    contexts: Option<seq<KubeCtx>>
}

// ☸ context (namespace), read from the kubeconfig files — no kubectl
// spawn on every prompt. KUBECONFIG may list several files; as in
// kubectl, the first current-context wins and contexts merge.
let kubeBit () =
    let files =
        match Env.get "KUBECONFIG" with
        | Some paths -> paths |> Str.split ":" |> Seq.where (fun p -> p <> "")
        | None -> [ $"{Path.home ()}/.kube/config" ]

    let configs =
        files
        |> Seq.where File.exists
        |> Seq.map (File.read >> from yaml KubeConfig)
        |> Seq.freeze

    match configs |> Seq.tryPick _.current with
    | None -> ""
    | Some ctx ->
        let ns =
            configs
            |> Seq.collect (fun c -> c.contexts |> Option.defaultValue [])
            |> Seq.tryFind (fun c -> c.name == ctx)
            |> Option.bind _.context.namespace
            |> Option.defaultValue "default"

        Color.green $"☸ {ctx} ({ns})" + " "

// ☁ subscription (resource group), read from az's own files — `az` is a
// Python start-up per prompt. The group is `az config set defaults.group`.
let azureBit () =
    let dir = Env.get "AZURE_CONFIG_DIR" |> Option.defaultValue $"{Path.home ()}/.azure"
    let profile = $"{dir}/azureProfile.json"

    if File.exists profile then
        let p = File.read profile |> from json {| subscriptions: seq<{| name: string; isDefault: bool |}> |}

        match p.subscriptions |> Seq.tryFind _.isDefault with
        | None -> ""
        | Some sub ->
            let cfg = $"{dir}/config"

            let group =
                if File.exists cfg then
                    File.read cfg |> Seq.tryPick (Str.rmatch @"^\s*group\s*=\s*(\S+)") |> Option.map Seq.head
                else
                    None

            let label = Color.blue $"☁ {sub.name}"
            let rg = group |> Option.map (fun g -> " " + Color.sgr "94" $"({g})") |> Option.defaultValue ""
            label + rg + " "
    else
        ""

let prompt status =

    let repo = git rev-parse --is-inside-work-tree | complete

    let gitBit =
        if repo.exitCode == 0 then
            let b = git rev-parse --abbrev-ref HEAD | complete
            let branch = b.stdout |> Seq.tryHead |> Option.defaultValue "?"

            let u = git rev-parse --abbrev-ref "@{u}" | complete
            let upstream = u.stdout |> Seq.tryHead |> Option.defaultValue ""

            let ref =
                if u.exitCode <> 0 || upstream == $"origin/{branch}" then
                    branch
                else
                    $"{branch}:{upstream}"

            // ⇡: commits not on the upstream — or, without one, on no remote
            let unpushed =
                if u.exitCode == 0 then
                    git rev-list -1 "@{u}..HEAD" | complete
                else
                    git rev-list -1 HEAD --not --remotes | complete

            let ahead = if Seq.isEmpty unpushed.stdout then "" else Color.cyan "⇡"

            let lines = git status --porcelain |> Seq.freeze
            let staged = lines |> Seq.exists (Str.isMatch @"^[^ ?]")
            let dirty = lines |> Seq.exists (Str.isMatch @"^.[^ ]")
            let stashed = git stash list |> Seq.isEmpty |> not
            let hasMark = dirty || staged || stashed

            let marks = $<<<
                { if hasMark then Color.red "[" else "" }
                { if dirty then Color.red "!" else "" }
                { if staged then Color.green "+" else "" }
                { if stashed then Color.yellow "$" else "" }
                { if hasMark then Color.red "] " else "" }

            $"{Color.magenta ""} {Color.magenta ref}{ahead} {marks |> Str.join ""}"
        else
            ""
    let tint = if status.ok then Color.green else Color.magenta
    let cwd = pwd |> Color.dim
    let w = "≋ "
    let container =
        Env.get "ROOZ_META_WORKSPACE"
        |> Option.map (fun c -> $"⬢ {c} ")
        |> Option.defaultValue ""
        |> Color.dim
    print $"{kubeBit ()}{w}{cwd} {gitBit}{Project.badge pwd}{azureBit ()}{container}"
    $"{tint "❯"} "

#session {
    env = [
        "CONTAINER_NAME", File.read "/etc/hostname" |> Seq.freeze |> Seq.exactlyOne
        "COLORTERM", "truecolor"
        "MICRO_TRUECOLOR", "1"
        "EDITOR", "micro"
    ]
    prompt = prompt
}
